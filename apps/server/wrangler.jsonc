{
  // MAREA: un solo Worker serve il client (assets = build di apps/client), l'API e i WebSocket dei Durable Object. Tutto sul piano gratuito.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "marea",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/manifest.webmanifest"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "marea", "database_id": "2a3c4e32-4974-44d5-bb2a-aca1c39230a9", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ZONE", "class_name": "Zone" },
      { "name": "LOT", "class_name": "Lot" },
      { "name": "SFIDE", "class_name": "Sfide" },
      { "name": "SPEDIZIONI", "class_name": "Spedizioni" },
      { "name": "GARA_AMICI", "class_name": "GaraAmici" }
    ]
  },
  // v2 (M1): Sfide = coordinatore unico delle sfide con posta (una sola istanza, idFromName('tavolo')).
  // v3 (#118): Spedizioni = squadre e dungeon insieme (una sola istanza, idFromName('spedizioni')).
  // v4 (corse tra amici): GaraAmici = sala e gara a fantasmi in tempo reale (una sola istanza, idFromName('garaamici')).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Zone", "Lot"] }, { "tag": "v2", "new_sqlite_classes": ["Sfide"] }, { "tag": "v3", "new_sqlite_classes": ["Spedizioni"] }, { "tag": "v4", "new_sqlite_classes": ["GaraAmici"] }]
}
